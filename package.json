  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/main.ts",
    "start": "node dist/cli/main.js",
    "web": "tsx src/web/server.ts",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "keywords": [
